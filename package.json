{
    "name": "@buildkite/buildkite-sdk",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "agent:local": "buildkite-agent start --token $BUILDKITE_AGENT_TOKEN_LOCAL_BUILDKITE_SDK",
        "postinstall": "nx install:all --verbose",
        "pipeline": "nx gen:pipeline",
        "pipeline-release": "nx gen:pipeline-release",
        "types": "nx gen:types",
        "types-go": "nx gen:types-go",
        "types-py": "nx gen:types-python",
        "types-ts": "nx gen:types-typescript",
        "test": "nx test:all",
        "build": "nx build:all",
        "docs": "nx docs:all",
        "docs:serve": "nx run-many --parallel --target 'docs:serve' --projects 'sdk-typescript,sdk-python,sdk-ruby' --output-style 'stream'",
        "docs:publish": "nx docs:publish",
        "apps": "nx run:all",
        "clean": "nx clean:all",
        "watch": "npx nx watch --all -- nx rebuild:all",
        "format": "npx nx format:all",
        "dev": "concurrently 'npm run docs:serve' 'npm run watch' --kill-others"
    },
    "private": true,
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@nx/esbuild": "23.2.1",
        "@nx/eslint": "23.2.1",
        "@nx/eslint-plugin": "23.2.1",
        "@nx/jest": "23.2.1",
        "@nx/js": "23.2.1",
        "@nx/node": "23.2.1",
        "@nx/web": "23.2.1",
        "@swc-node/register": "~1.12.0",
        "@swc/core": "~1.16.0",
        "@swc/helpers": "~0.5.11",
        "@types/jest": "30.0.0",
        "@types/node": "24.13.3",
        "ajv": "^8.17.1",
        "esbuild": "^0.28.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "10.1.8",
        "jest": "30.5.1",
        "jest-environment-node": "^30.0.0",
        "jest-util": "30.5.1",
        "json-schema-to-typescript": "^16.0.0",
        "mustache": "^4.2.0",
        "nx": "23.2.1",
        "prettier": "^3.0.0",
        "ts-jest": "^29.4.5",
        "toml": "^5.0.0",
        "ts-node": "10.9.2",
        "tslib": "^2.3.0",
        "typedoc": "^0.28.14",
        "typescript": "5.9.3",
        "typescript-eslint": "8.67.0",
        "yaml": "^2.7.0"
    },
    "workspaces": [
        "apps/**",
        "sdk/**",
        "infra",
        "ci"
    ],
    "dependencies": {
        "@octokit/rest": "^22.0.0",
        "axios": "^1.13.5",
        "rimraf": "^6.1.2"
    }
}
